  {
    "@id": "urn:ms-quant:NSAF",
    "urn:ms-quant:definition": [
      {
        "@value": "A spectral count-based quantification method that calculates the Normalized Spectral Abundance Factor (NSAF) by dividing each protein's spectral count by its sequence length and normalizing the resulting value across all quantified proteins.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
