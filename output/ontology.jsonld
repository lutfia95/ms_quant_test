  {
    "@id": "urn:ms-quant:CorrectionFactorMatrix",
    "urn:ms-quant:definition": [
      {
        "@value": "A matrix of correction factors describing the contributions of isotopic impurities between reporter ion channels in an isobaric labeling experiment, used to correct measured reporter ion intensities for isotopic interference.",
