      }
    ]
  },
  {
    "@id": "urn:ms-quant:Method",
    "urn:ms-quant:definition": [
      {
        "@value": "A procedure applied to proteomic data in order to produce, transform or summarise quantitative values",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
