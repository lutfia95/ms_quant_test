    "@id": "urn:ms-quant:SpectralCountBased",
    "urn:ms-quant:definition": [
      {
        "@value": "A label-free quantification approach that estimates protein abundance from the number of tandem mass spectra or peptide-spectrum matches assigned to a protein.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
