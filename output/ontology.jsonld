  {
    "@id": "urn:ms-quant:SAF",
    "urn:ms-quant:definition": [
      {
        "@value": "A spectral count-based quantification method that calculates the Spectral Abundance Factor (SAF) by normalizing the spectral count assigned to a protein by its sequence length.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
