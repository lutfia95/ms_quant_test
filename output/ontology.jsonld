        "@id": "urn:ms-quant:MissingValueImputationMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:InputConstraint",
    "urn:ms-quant:definition": [
      {
        "@value": "A specification of the requirements or restrictions that input data must satisfy to be considered valid for a particular computational method or processing step in a quantitative proteomics workflow.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "InputConstraint",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:AggregationMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:quantifiesEntity",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
