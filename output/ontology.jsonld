      {
        "@value": "MetabolicLabeling"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:LabelBasedQuantification"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:StatisticalResults",
    "urn:ms-quant:definition": [
      {
        "@value": "A result obtained from a statistical analysis of quantitative data, including measures of variability, uncertainty, association, effect size, or statistical significance.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "StatisticalResults",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:Result"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:UMAPReduction",
    "urn:ms-quant:definition": [
      {
        "@value": "A nonlinear dimensionality reduction method that uses Uniform Manifold Approximation and Projection (UMAP) to construct a low-dimensional embedding by optimizing a representation of the data's neighborhood relationships.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "UMAPReduction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:NonlinearDimensionalityReduction"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:MissForestImputation",
    "urn:ms-quant:name": [
      {
        "@value": "MissForest imputation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A missing value imputation method in which missing measurements are predicted using an ensemble of decision trees trained iteratively on observed values.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "MissingValueImputationMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      },
      {
        "@value": "ModelBasedImputationMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "MissForest captures nonlinear relationships but may introduce bias and has high computational cost for large datasets.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "MissForestImputation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:ModelBasedImputationMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:hasEntry",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "hasEntry"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:QuantifiedPeptide",
    "urn:ms-quant:definition": [
      {
        "@value": "A peptide sequence for which a quantitative abundance measurement is determined by aggregating or evaluating associated mass spectrometry signals.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
