      {
        "@value": "QuantifiedEntity"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:CyclicLOESSNormalization",
    "urn:ms-quant:name": [
      {
        "@value": "Cyclic LOESS normalization",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:generated_by": [
      {
        "@value": "ProcessingSoftware",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:has_exact_synonym": [
      {
        "@value": "CyclicLocallyWeightedScatterplotSmoothingNormalization",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A normalization method in which measurements are iteratively adjusted using pairwise LOESS smoothing to remove systematic intensity-dependent biases across samples.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "NormalizationMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "The method iteratively removes pairwise intensity-dependent biases across samples. It is computationally intensive and assumes the majority of features are not differentially abundant.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "CyclicLOESSNormalization",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:NormalizationMethod"
      }
    ]
  },
