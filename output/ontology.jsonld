    "@id": "urn:ms-quant:QuantifiedFragment",
    "urn:ms-quant:definition": [
      {
        "@value": "A fragment ion generated from a peptide precursor for which a quantitative signal intensity or abundance measurement is determined by mass spectrometry.",
