        "@id": "urn:ms-quant:StatisticalMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:FStatistic",
    "urn:ms-quant:definition": [
      {
        "@value": "A test statistic formed as a ratio of variance-related estimates and evaluated against an F-distribution under the null hypothesis.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "FStatistic"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:TestStatistic"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:SpearmansRho",
    "urn:ms-quant:has_synonym": [
      {
        "@value": "Spearman correlation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      },
