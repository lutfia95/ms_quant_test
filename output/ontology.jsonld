  {
    "@id": "urn:ms-quant:MedianNormalization",
    "urn:ms-quant:name": [
      {
        "@value": "Median normalization",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A normalization method in which  measurements are normalized so that the median intensity is equal across samples.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "NormalizationMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "MedianNormalization",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:NormalizationMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:InternalReferenceNormalization",
    "urn:ms-quant:name": [
      {
        "@value": "Internal reference normalization",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:has_exact_synonym": [
      {
        "@value": "IRSNormalization",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A normalization method in which measurements are normalized relative to a designated internal reference, such as an internal standard.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "NormalizationMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "The method reduces inter-batch variability using a shared reference. Its effectiveness depends on reference sample quality and consistency.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "InternalReferenceNormalization",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:NormalizationMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:TopN",
    "urn:ms-quant:definition": [
      {
        "@value": "An input constraint that retains only the N highest-ranked quantitative entities according to a specified ranking criterion.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "TopN"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:InputConstraint"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:MedianImputation",
    "urn:ms-quant:name": [
      {
        "@value": "Median imputation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:has_exact_synonym": [
      {
        "@value": "MiddleValueImputation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A missing value imputation method in which each missing measurement is replaced by the median of the observed values for the same feature (e.g., protein, peptide, or ion) across a defined set of samples or conditions.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "MissingValueImputationMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "Median imputation is more robust to outliers than mean imputation but still reduces variance and may bias downstream analyses, especially when missingness is not random.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "MedianImputation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:MissingValueImputationMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:LabelBasedQuantification",
    "urn:ms-quant:definition": [
      {
        "@value": "A quantification approach that uses stable isotope labels or other distinguishable labeling reagents to measure peptide or protein abundance across samples.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "LabelBasedQuantification"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:QuantificationMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:VarianceStabilizingNormalization",
    "urn:ms-quant:has_part": [
      {
        "@value": "VarianceStabilizingTransformation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:name": [
      {
        "@value": "Variance-stabilizing normalization",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A normalization method that combines the estimation of a mean-variance model with application of a variance-stabilizing trnasformation and between-sample normalization in order to produce variance-stabilized and normalized quantitative measurements.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "NormalizationMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "Variance stabilizing normalization (VSN) refers to model-based procedures that estimate parameters of an intensity-dependent variance function and apply a derived transformation while simultaneously performing normalization across samples. It is broader in scope than variance stabilizing transformation alone.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "VarianceStabilizingNormalization",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@value": "MS:1002211",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:NormalizationMethod"
      }
    ],
    "urn:ms-quant:accession": [
      {
        "@value": "MS:1002211"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:VarianceWeighted",
    "urn:ms-quant:definition": [
      {
        "@value": "A weighting scheme that assigns weights to quantitative measurements based on their estimated variances, typically giving greater influence to measurements with lower variance.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "VarianceWeighted"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:WeightingScheme"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:ComBatBatchCorrection",
    "urn:ms-quant:has_exact_synonym": [
      {
        "@value": "EmpiricalBayesBatchCorrection",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A batch correction method in which additive and multiplicative batch effects in data are modeled and adjusted using an empirical Bayes framework that shrinks batch-specific parameter estimates toward a pooled prior distribution.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "BatchEffectCorrectionMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "The method adjusts both location and scale effects. It requires correct batch annotation and assumes batch effects are separable from biological covariates included in the model.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "ComBatBatchCorrection",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:BatchEffectCorrectionMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:TargetedQuantification",
    "urn:ms-quant:definition": [
      {
        "@value": "A quantification approach that selectively measures predefined peptides or proteins using mass spectrometry acquisition methods configured to monitor specific analytes.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "TargetedQuantification"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:QuantificationMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:TMT",
    "urn:ms-quant:definition": [
      {
        "@value": "An isobaric label-based quantification method that uses Tandem Mass Tag reagents to multiplex samples and determine relative peptide or protein abundances from mass spectrometry measurements.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "TMT"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@value": "MS:1002010",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:IsobaricLabelQuantification"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:WilcoxonSignedRankTest",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "WilcoxonSignedRankTest"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:HypothesisTestMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:hasCorrectionValue",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "hasCorrectionValue"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:SpectralEmbedding",
    "urn:ms-quant:definition": [
      {
        "@value": "A nonlinear dimensionality reduction method that constructs a lower-dimensional representation from eigenvectors of a graph Laplacian derived from similarities between observations.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "SpectralEmbedding"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:NonlinearDimensionalityReduction"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:Log2FoldChange",
    "urn:ms-quant:has_synonym": [
      {
        "@value": "log2 fold change",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      },
      {
        "@value": "log2 fold-change",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      },
      {
        "@value": "log2FC",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:name": [
      {
        "@value": "log2 fold change",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:generated_by": [
      {
        "@value": "StatisticalSoftware",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "The base-2 logarithm of the fold change between two experimental conditions.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "RatioBasedEffectSize",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "log2 fold change is commonly used in proteomics because equal-magnitude increases and decreases are represented symmetrically: e.g. log2FC = 1 corresponds to a 2-fold increase and log2FC = −1 corresponds to a 2-fold decrease.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Log2FoldChange"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:RatioBasedEffectSize"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:AbundanceUnit",
    "urn:ms-quant:definition": [
      {
        "@value": "A quantification unit used to express the amount or relative abundance of a molecular entity.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "AbundanceUnit"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:QuantificationUnit"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:tSNEReduction",
    "urn:ms-quant:definition": [
      {
        "@value": "A nonlinear dimensionality reduction method that uses t-distributed stochastic neighbor embedding (t-SNE) to represent high-dimensional observations in a low-dimensional space by minimizing divergence between neighborhood probability distributions.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "tSNEReduction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:NonlinearDimensionalityReduction"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:ScoreWeighted",
    "urn:ms-quant:definition": [
      {
        "@value": "A weighting scheme that assigns weights to quantitative measurements based on their associated identification or quality scores, according to a specified score-to-weight mapping.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "ScoreWeighted"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:WeightingScheme"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:MeanAggregation",
    "urn:ms-quant:definition": [
      {
        "@value": "Aggregation by arithmetic mean of input feature intensities for each\ntarget feature. Missing values are excluded from the mean calculation\nunless imputation has been applied prior to aggregation.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "MeanAggregation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@value": "MS:1002962",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:UserAppliedAggregation"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:BenjaminiHochbergAdjusted",
    "urn:ms-quant:definition": [
      {
        "@value": "An adjusted p-value obtained using the Benjamini–Hochberg procedure to control the false discovery rate across multiple hypothesis tests.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "BenjaminiHochbergAdjusted",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:AdjustedPValue"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:QRILCImputation",
    "urn:ms-quant:name": [
      {
        "@value": "QRILC imputation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:has_exact_synonym": [
      {
        "@value": "quantile regression imputation of left-censored data",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A missing value imputation method in which missing measurements are replaced by random values drawn from a left-censored distribution estimated by quantile regression on observed intensities, thereby modeling missingness as arising from signals below the limit of detection.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "LeftCensoredImputationMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      },
      {
        "@value": "MissingValueImputationMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "QRILC imputation explicitly models left-censoring and preserves distributional structure of low-intensity values, but relies on assumptions about censoring behavior and the fitted regression model.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "QRILCImputation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:LeftCensoredImputationMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:Skyline",
    "urn:ms-quant:bioToolsCURIE": [
      {
        "@value": "biotools:skyline",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:bioToolsID": [
      {
        "@value": "skyline",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "IdentificationSoftware",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      },
      {
        "@value": "QuantificationSoftware",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      },
      {
        "@value": "ProcessingSoftware",
        "@language": "w"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Skyline"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@value": "MS:1000922",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      },
      {
        "@id": "https://bio.tools/skyline"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:Implementation"
      }
    ],
    "urn:ms-quant:accession": [
      {
        "@value": "MS:1000922"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:RemoveBatchEffectBatchCorrection",
    "urn:ms-quant:has_exact_synonym": [
      {
        "@value": "LimmaRemoveBatchEffectBatchCorrection",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A batch correction method that removes estimated batch-associated effects from a data matrix by fitting a linear model and subtracting the batch component, producing a batch-adjusted matrix.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "BatchEffectCorrectionMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "The method is applied post hoc to generate corrected data for visualization or unsupervised analysis. It requires correct batch annotation and assumes batch effects are separable from biological covariates included in the model.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "RemoveBatchEffectBatchCorrection",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:BatchEffectCorrectionMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:SILAC",
    "urn:ms-quant:definition": [
      {
        "@value": "A metabolic labeling method that uses Stable Isotope Labeling by Amino Acids in Cell Culture (SILAC) to incorporate isotopically distinct amino acids into proteins for mass spectrometry-based quantification.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "SILAC"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@value": "MS:1001835",
