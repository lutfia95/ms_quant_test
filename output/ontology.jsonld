      }
    ]
  },
  {
    "@id": "urn:ms-quant:SRM%2FMRM",
    "urn:ms-quant:definition": [
      {
        "@value": "A targeted quantification method that uses Selected or Multiple Reaction Monitoring (SRM/MRM) to measure predefined precursor-to-fragment ion transitions for quantitative analysis of specific peptides.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "SRM/MRM"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@value": "MS:1000206",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      },
      {
        "@value": "MS:1001838",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
