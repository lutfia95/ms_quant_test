      }
    ]
  },
  {
    "@id": "urn:ms-quant:CanonicalCorrelationAnalysis",
    "urn:ms-quant:definition": [
      {
        "@value": "A multivariate statistical method that identifies pairs of linear combinations of variables from two datasets that maximize their mutual correlation.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
