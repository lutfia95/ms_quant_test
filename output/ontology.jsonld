        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "log10 fold change is less common than log2 fold change in proteomics. A value of 1 corresponds to a 10-fold increase and −1 to a 10-fold decrease.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
