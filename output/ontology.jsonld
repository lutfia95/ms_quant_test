  {
    "@id": "urn:ms-quant:SVDImputation",
    "urn:ms-quant:name": [
      {
        "@value": "SVD imputation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:has_exact_synonym": [
      {
        "@value": "SingularValueDecompositionImputation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A missing value imputation method in which missing measurements are estimated using a low-rank approximation of the data matrix derived from singular value decomposition.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "LowRankImputationMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      },
      {
        "@value": "MissingValueImputationMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "SVD imputation assumes linear structure and may bias results when missingness is extensive or non-random.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
