      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "quantifiesEntity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "urn:ms-quant:QuantifiedEntity"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:AdjustedPValue",
    "urn:ms-quant:definition": [
      {
        "@value": "A p-value modified using a multiple-testing correction procedure to account for the simultaneous evaluation of multiple statistical hypotheses.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "AdjustedPValue"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:SignificanceScore"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:PCAReduction",
    "urn:ms-quant:definition": [
      {
        "@value": "A linear dimensionality reduction method that uses principal component analysis (PCA) to project data onto orthogonal directions of maximum variance.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "PCAReduction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:LinearDimensionalityReduction"
      }
    ]
