  {
    "@id": "urn:ms-quant:MedianPolishAggregation",
    "urn:ms-quant:definition": [
      {
        "@value": "Peptide-to-protein aggregation using Tukey's median polish algorithm.\nRow and column medians are iteratively removed from the peptide\nintensity matrix until convergence, producing protein-level summaries\nthat are robust to outlier peptides and systematic row or column\neffects. Default aggregation method in MSstats.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "MedianPolishAggregation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@value": "PMID:21172910",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:UserAppliedAggregation"
      }
    ]
  },
