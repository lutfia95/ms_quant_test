  {
    "@id": "urn:ms-quant:ComBatseqBatchCorrection",
    "urn:ms-quant:has_exact_synonym": [
      {
        "@value": "ComBatForCountDataBatchCorrection",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A batch correction method that extends the ComBat empirical Bayes framework to count-based data using generalized linear models with appropriate distributional assumptions (negative binomial distribution).",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "BatchEffectCorrectionMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "The method is designed primarily for sequencing count data. It is less commonly applied to continuous intensity-based mass spectrometry data. It requires correct batch annotation and assumes batch effects are separable from biological covariates included in the model.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "ComBatseqBatchCorrection",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:BatchEffectCorrectionMethod"
      }
    ]
  },
