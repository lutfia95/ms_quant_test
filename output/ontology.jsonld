        "@id": "urn:ms-quant:QuantifiedEntity"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:TotalIntensityNormalization",
    "urn:ms-quant:name": [
      {
        "@value": "Total intensity normalization",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A normalization method in which measurements are normalized so that the total signal intensity (sum, mean, or median) is equal across samples.",
