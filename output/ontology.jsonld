      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A bias-corrected standardized mean difference obtained by applying a small-sample correction to a standardized mean difference, commonly Cohen’s d.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
