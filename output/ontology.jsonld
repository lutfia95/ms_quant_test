        "@value": "Max absolute normalization",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A normalization method in whichmeasurements are normalized by the maximum absolute value observed for each feature or sample.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "NormalizationMethod",
