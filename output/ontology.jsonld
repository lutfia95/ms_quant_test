  {
    "@id": "urn:ms-quant:BonferroniAdjusted",
    "urn:ms-quant:definition": [
      {
        "@value": "An adjusted p-value obtained using the Bonferroni procedure to control the family-wise error rate by accounting for the number of statistical hypotheses tested.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "BonferroniAdjusted",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:AdjustedPValue"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:RawMeanDifference",
    "urn:ms-quant:has_synonym": [
      {
        "@value": "difference in means",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      },
      {
        "@value": "mean difference",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:name": [
      {
        "@value": "raw mean difference",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:generated_by": [
      {
        "@value": "StatisticalSoftware",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "Difference between the mean abundance values of two conditions.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "MeanDifferenceEffectSize",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "Useful when abundance is reported on a directly interpretable scale. Unlike standardized mean differences, it retains the original measurement units.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "RawMeanDifference"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:MeanDifferenceEffectSize"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:QuantificationSoftware",
    "urn:ms-quant:has_synonym": [
      {
        "@value": "quantitation software",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:name": [
      {
        "@value": "Quantification Software",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:has_function": [
      {
        "@value": "quantification function",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A software that has the function of determining numerical abundance or concentration values from experimental measurement data.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "Software",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "QuantificationSoftware"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@value": "MS:1001139",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:Category"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:DownshiftedNormalDistributionImputation",
    "urn:ms-quant:name": [
      {
        "@value": "Down-shifted normal distribution imputation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:has_exact_synonym": [
      {
        "@value": "LeftShiftedGaussianImputation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A missing value imputation method in which each missing measurement is replaced by a random value drawn from a normal distribution whose mean is shifted to lower values relative to the observed data distribution, typically with reduced variance, to represent low-abundance signals near the limit of detection.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "LeftCensoredImputationMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      },
      {
        "@value": "MissingValueImputationMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "Downshifted normal distribution imputation assumes missing values are left-censored and introduces stochastic low-intensity values; outcomes are sensitive to the chosen mean shift and variance parameters.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "DownshiftedNormalDistributionImputation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:LeftCensoredImputationMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:MedianAggregation",
    "urn:ms-quant:definition": [
      {
        "@value": "Aggregation by median of input feature intensities for each target\nfeature. Missing values are excluded from the median calculation unless\nimputation has been applied prior to aggregation. More robust to\noutlier peptides than mean aggregation.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "MedianAggregation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@value": "MS:1002883",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:UserAppliedAggregation"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:TransitionWeighted",
    "urn:ms-quant:definition": [
      {
        "@value": "A weighting scheme that assigns weights to quantitative measurements based on the properties or quality of their associated precursor–fragment ion transitions.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "TransitionWeighted"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:WeightingScheme"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:KNNImputation",
    "urn:ms-quant:name": [
      {
        "@value": "KNN imputation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:has_exact_synonym": [
      {
        "@value": "kNNImputation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      },
      {
        "@value": "kNearestNeighborsImputation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A missing value imputation method in which each missing measurement is estimated from a weighted or unweighted aggregate (e.g., mean or median) of the corresponding measurements in the k most similar features or samples, where similarity is defined by a distance metric computed on observed data.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "MissingValueImputationMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "k-nearest neighbors imputation leverages local similarity structure in the data but is sensitive to the choice of k, distance metric, and data scaling, and may perform poorly when missingness is extensive.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "KNNImputation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:NeighborBasedImputationMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:TechnicalReplicate",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "TechnicalReplicate"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
