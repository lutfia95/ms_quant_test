      }
    ]
  },
  {
    "@id": "urn:ms-quant:FDRAdjusted",
    "urn:ms-quant:definition": [
      {
        "@value": "A multiple-testing-adjusted significance measure obtained using a procedure designed to control or estimate the false discovery rate among rejected hypotheses.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "FDRAdjusted",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:AdjustedPValue"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:AggregationMethod",
    "urn:ms-quant:definition": [
      {
        "@value": "A computational method used to combine multiple quantitative measurements into a single representative value at a specified level of aggregation, such as peptide, protein, or protein group, in a quantitative proteomics analysis.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "AggregationMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:Method"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:HypothesisTestMethod",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "HypothesisTestMethod"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
