  {
    "@id": "urn:ms-quant:ScalingMethod",
    "urn:ms-quant:definition": [
      {
        "@value": "Scaling adjusts the magnitude or variance of features and modifies the spread (range or variance) of values typically across samples.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "Scaling changes the relative influence of features. Scaling prevents high-variant features from dominating multivariate analyses.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
