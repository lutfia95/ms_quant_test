        "@value": "Method"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:BPCAImputation",
    "urn:ms-quant:name": [
      {
        "@value": "BPCA imputation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:has_exact_synonym": [
      {
        "@value": "BayesianPCAImputation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A missing value imputation method in which missing measurements are estimated using Bayesian principal component analysis, modeling the data with a low-dimensional latent structure and incorporating uncertainty in the estimates.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "LowRankImputationMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      },
      {
        "@value": "MissingValueImputationMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "BPCA imputation captures global correlation structure but assumes approximate low-rank data and can oversmooth local variation.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "BPCAImputation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:LowRankImputationMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:MinDetImputation",
    "urn:ms-quant:name": [
      {
        "@value": "MinDet imputation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:has_exact_synonym": [
      {
        "@value": "MinimumDetectionImputation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A missing value imputation method in which each missing measurement is replaced by a minimal deterministic value, typically set at the lowest observed intensity or just below the detection limit, to represent signals that are present but below the limit of detection.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "LeftCensoredImputationMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      },
      {
        "@value": "MissingValueImputationMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "MinDet imputation is deterministic, preserves low-intensity signals, and is less stochastic than methods like MinProb imputation, but it can artificially reduce variance and bias downstream statistical analyses.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "MinDetImputation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:LeftCensoredImputationMethod"
      }
    ]
  },
