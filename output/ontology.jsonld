      {
        "@value": "An isobaric labeling batch in which samples are labeled with distinct Tandem Mass Tag (TMT) reagent channels and combined for multiplexed quantitative mass spectrometry analysis.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
