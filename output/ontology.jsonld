        "@value": "MS:1002547",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:SpectralCountBased"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:TopNAggregation",
    "urn:ms-quant:definition": [
      {
        "@value": "Aggregation using only the N most intense input features per target\nfeature. Features are ranked by intensity and only the top N are\nincluded in the reduction step. The reduction operator (mean, median,\nor sum) applied to the selected features must be specified. N is a\nrequired parameter.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "TopNAggregation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:UserAppliedAggregation"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:QuantifiedModification",
    "urn:ms-quant:definition": [
      {
        "@value": "A post-translational or chemical modification for which a quantitative abundance or relative occupancy measurement is determined from mass spectrometry data.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
