  {
    "@id": "urn:ms-quant:SupervisedDimensionalityReduction",
    "urn:ms-quant:definition": [
      {
        "@value": "A dimensionality reduction method that uses known class labels, response variables, or other supervised information to construct a lower-dimensional representation of the data.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "SupervisedDimensionalityReduction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:DimensionalityReductionMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:SharedAllowed",
    "urn:ms-quant:definition": [
      {
        "@value": "An input constraint that permits peptides mapping to multiple proteins or protein groups to contribute to quantitative analysis.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "SharedAllowed"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:InputConstraint"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:TransitionSpecific",
    "urn:ms-quant:definition": [
      {
        "@value": "An input constraint that retains only monitored precursor–fragment ion transitions considered specific to the target analyte for quantitative analysis.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "TransitionSpecific"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:InputConstraint"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:UnitVectorScaling",
    "urn:ms-quant:name": [
      {
        "@value": "Unit vector scaling",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:has_exact_synonym": [
      {
        "@value": "L2scaling",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A scaling method in which measurements are scaled so that each sample vector has unit length.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "ScalingMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "UnitVectorScaling",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:ScalingMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:LimmaBatchCorrection",
    "urn:ms-quant:has_exact_synonym": [
      {
        "@value": "LinearModelBatchAdjustment",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A batch correction method in which batch effects are modeled as covariates in a linear modeling framework and adjusted during model fitting.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "BatchEffectCorrectionMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "Batch variables are included as covariates in a linear modeling framework during differential abundance analysis, allowing batch effects to be adjusted during parameter estimation rather than by directly modifying the data matrix. The method is suitable for complex experimental designs. This approach preserves raw values but adjusts estimated contrasts. Appropriate when the primary goal is hypothesis testing rather than data visualization. It requires correct batch annotation and assumes batch effects are separable from biological covariates included in the model.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "LimmaBatchCorrection",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:BatchEffectCorrectionMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:RatioBasedEffectSize",
    "urn:ms-quant:generated_by": [
      {
        "@value": "StatisticalSoftware",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "An effect size expressing the relative magnitude of a quantitative measurement between two groups or conditions as a ratio.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "EffectSize",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "Ratio effect sizes include fold change and logarithmically transformed fold changes.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "RatioBasedEffectSize",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:EffectSize"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:ConfidenceWeighted",
    "urn:ms-quant:definition": [
      {
        "@value": "A weighting scheme that assigns weights to quantitative measurements based on their associated confidence estimates, giving greater influence to measurements considered more reliable.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "ConfidenceWeighted"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:WeightingScheme"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:Category",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Category"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:Software"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:SumAggregation",
    "urn:ms-quant:definition": [
      {
        "@value": "Aggregation by summation of all input feature intensities for each\ntarget feature. All qualifying input features contribute equally with\nno weighting. Missing values are excluded from the sum unless a\nzero-fill imputation has been applied prior to aggregation.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "SumAggregation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:UserAppliedAggregation"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:ANOVA",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "ANOVA"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@value": "MS:1002071",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:HypothesisTestMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:PValue",
    "urn:ms-quant:definition": [
      {
        "@value": "The probability, under a specified null hypothesis and statistical model, of obtaining a test statistic at least as extreme as the observed value.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "PValue",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@value": "MS:1002072",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:SignificanceScore"
      }
    ],
    "urn:ms-quant:accession": [
      {
        "@value": "MS:1002072"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:IsomapReduction",
    "urn:ms-quant:definition": [
      {
        "@value": "A nonlinear dimensionality reduction method that estimates geodesic distances between observations on a neighborhood graph and uses multidimensional scaling to construct a lower-dimensional embedding.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "IsomapReduction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:NonlinearDimensionalityReduction"
      }
    ]
  },
  {
    "@id": "http://www.w3.org/2000/01/rdf-schema#seeAlso",
