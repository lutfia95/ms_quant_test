        "@value": "Base2LogarithmicTransformation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A data transformation method in which measurements are transformed using the logarithm with base 2.",
