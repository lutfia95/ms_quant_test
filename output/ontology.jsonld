      {
        "@value": "MS:1001808"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:common",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#AnnotationProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "common"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:MetabolicLabeling",
    "urn:ms-quant:definition": [
      {
        "@value": "A label-based quantification approach that incorporates isotopically labeled metabolic precursors into proteins during biological synthesis, enabling quantitative comparison by mass spectrometry.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
