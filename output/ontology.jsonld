      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "hasChannelLabel"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:Process",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Process",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:StandardizedMeanDifferenceEffectSize",
    "urn:ms-quant:generated_by": [
      {
        "@value": "StatisticalSoftware",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "An effect size expressing the difference between two group means in units of a standard deviation.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "EffectSize",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "Appropriate when abundance measurements from two groups are compared on a standardized scale. Cohen’s d, Glass’s Δ, and Hedges’ g are standardized mean-difference measures.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "StandardizedMeanDifferenceEffectSize",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:EffectSize"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:QuantifiedPeptideIon",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "QuantifiedPeptideIon"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@value": "MS:1002734",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      },
      {
        "@value": "MS:1003051",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:QuantifiedEntity"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:ReferenceChannelNormalization",
    "urn:ms-quant:name": [
      {
        "@value": "Reference-channel normalization",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A normalization method in which measurements are normalized relative to a designated reference channel, commonly used in isobaric labeling experiments.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "NormalizationMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "ReferenceChannelNormalization",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:NormalizationMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:FullyObserved",
    "urn:ms-quant:definition": [
      {
        "@value": "An input constraint that retains only quantitative entities with valid observations across all required samples, channels, or experimental conditions.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "FullyObserved"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:InputConstraint"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:LabelFreeQuantification",
    "urn:ms-quant:definition": [
      {
        "@value": "A quantification approach that estimates peptide or protein abundance directly from mass spectrometry measurements without introducing isotope or chemical labeling reagents.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "LabelFreeQuantification"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@value": "MS:1001834",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:QuantificationMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:PPB",
    "urn:ms-quant:definition": [
      {
        "@value": "An abundance unit representing parts per billion, corresponding to one part of an analyte per billion parts of the reference quantity.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "PPB"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@value": "UO:0000170",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:AbundanceUnit"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:VarianceStabilizingTransformation",
    "urn:ms-quant:has_exact_synonym": [
      {
        "@value": "VST",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A data transformation method in which measurements are transformed to reduce or eliminate dependence of the variance of the mean, thereby approdimating heteroscedasticity across the intensity range.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "TransformationMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "Variance stabilizing transformation (VST) is typically applied to high-throughput quantitative data exhibiting mean–variance dependence. The transformation may be parametric or non-parametric and does not necessarily include between-sample scaling or normalization.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "VarianceStabilizingTransformation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:TransformationMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:EngineInternalAggregation",
    "urn:ms-quant:definition": [
      {
        "@value": "An aggregation method in which multiple quantitative measurements are combined internally by a proteomics analysis software engine using its built-in aggregation procedure, without requiring a separately specified aggregation algorithm.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "EngineInternalAggregation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:AggregationMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:PRM",
    "urn:ms-quant:definition": [
      {
        "@value": "A targeted quantification method that uses Parallel Reaction Monitoring (PRM) to acquire high-resolution fragment ion spectra of selected precursor ions for peptide quantification.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "PRM"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@value": "MS:1003907",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:TargetedQuantification"
      }
    ],
    "urn:ms-quant:accession": [
      {
        "@value": "MS:1003907"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:TestStatistic",
    "urn:ms-quant:definition": [
      {
        "@value": "A numerical quantity calculated from sample data and used to evaluate a statistical hypothesis according to a specified sampling distribution or testing procedure.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "TestStatistic"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:StatisticalResults"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:IntensityUnit",
    "urn:ms-quant:definition": [
      {
        "@value": "A quantification unit or measurement scale used to express the magnitude of a mass spectrometric signal associated with an analyte.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "IntensityUnit"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@value": "MS:1000043",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:QuantificationUnit"
      }
    ],
    "urn:ms-quant:accession": [
      {
        "@value": "MS:1000043"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:BestScoringOnly",
    "urn:ms-quant:definition": [
      {
        "@value": "An input constraint that retains only the highest-scoring identification or measurement among competing candidates according to a specified scoring criterion.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "BestScoringOnly"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:InputConstraint"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:BiologicalReplicate",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "BiologicalReplicate"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
