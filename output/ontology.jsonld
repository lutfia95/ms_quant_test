      }
    ]
  },
  {
    "@id": "urn:ms-quant:iBAQ",
    "urn:ms-quant:definition": [
      {
        "@value": "Intensity-based absolute quantification. The sum of peptide intensities\nfor a protein is divided by the number of theoretically observable\ntryptic peptides (peptides between 6 and 30 amino acids). Provides an\napproximation of molar abundance enabling comparison across proteins\nwithin a sample.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "iBAQ"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@value": "PMID:21254386",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:UserAppliedAggregation"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:MinMaxScaling",
    "urn:ms-quant:name": [
      {
        "@value": "Min-max scaling",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A scaling method in which measurements are linearly rescaled to a fixed range, typically between zero and one.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "ScalingMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "MinMaxScaling",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:ScalingMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:MeanImputation",
    "urn:ms-quant:name": [
      {
        "@value": "Mean imputation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:has_exact_synonym": [
      {
        "@value": "AverageImputation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A missing value imputation method in which each missing measurement is replaced by the arithmetic mean of the observed values for the same feature (e.g., protein, peptide, or ion) across a defined set of samples or conditions.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "MissingValueImputationMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "Mean imputation preserves the feature mean but reduces variance and can bias downstream statistical analyses, particularly in the presence of non-random missingness.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "MeanImputation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:MissingValueImputationMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:hasCorrectionFactorMatrix",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
