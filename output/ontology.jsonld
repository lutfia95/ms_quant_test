      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "Kendall rank correlation coefficient measuring the ordinal association between two variables.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:common": [
      {
        "@value": "Kendall rank correlation is less common than Pearson or Spearman correlation, but is useful for ranked or ordinal associations.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "CorrelationEffectSize",
