        "@value": "MS:1001810",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:ExperimentalCondition"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:ChannelLabel",
    "urn:ms-quant:definition": [
      {
        "@value": "A label or identifier assigned to a specific quantification channel in a multiplexed proteomics experiment, distinguishing it from other channels within the same labeling scheme.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "ChannelLabel"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:ExperimentalDesign"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:ObservedInAtLeastK",
    "urn:ms-quant:definition": [
      {
        "@value": "An input constraint that retains only quantitative entities observed in at least a specified number (K) of samples, channels, or experimental conditions.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "ObservedInAtLeastK"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:InputConstraint"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:TMTChannel",
    "urn:ms-quant:definition": [
      {
        "@value": "An isobaric labeling channel within a Tandem Mass Tag (TMT) labeling scheme, associated with a specific TMT reagent that generates a distinguishable reporter ion for relative quantification in multiplexed mass spectrometry.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "TMTChannel"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@value": "MS:1002615",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:IsobaricLabelChannel"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:MADScaling",
    "urn:ms-quant:name": [
      {
        "@value": "MAD scaling",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A scaling method in which measurements are scaled using the median absolute deviation to achieve robust dispersion.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "ScalingMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "MADScaling",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:ScalingMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:MS2TIC",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "MS2TIC"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:MS2"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:NormalizationMethod",
    "urn:ms-quant:definition": [
      {
        "@value": "Normalization removes systematic technical bias between samples and adjusts measurements within samples to make them comparable.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "Normalization addresses systematic technical variation between samples. This are effects such as differences in total ion current, sample loading differences, instrument drift, and batch effects.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "NormalizationMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@value": "MS:1001484",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:ProcessingMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:FilteringMethod",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "FilteringMethod"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@value": "MS:1001486",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:ProcessingMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:AllInputs",
    "urn:ms-quant:definition": [
      {
        "@value": "An input constraint that permits all available quantitative measurements to be used in a computational analysis without applying additional input-selection restrictions.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "AllInputs"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:InputConstraint"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:hasLotNumber",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#DatatypeProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "hasLotNumber"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:bioToolsID",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#AnnotationProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "bioToolsID",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:RUVBasedBatchCorrection",
    "urn:ms-quant:has_exact_synonym": [
      {
        "@value": "RUVNormalization",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A batch correction method in which unwanted variation is estimated using control features, replicate samples, or residual structure and removed through factor analysis or regression modeling.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "BatchEffectCorrectionMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "The method requires appropriate control features or replicates. Misspecification can lead to under- or overcorrection.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "RUVBasedBatchCorrection",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:BatchEffectCorrectionMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:GlasssDelta",
    "urn:ms-quant:has_synonym": [
      {
        "@value": "Glass d",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      },
      {
        "@value": "Glass delta",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:name": [
      {
        "@value": "Glass's delta",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:generated_by": [
      {
        "@value": "StatisticalSoftware",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "The difference between the means of two groups divided by the standard deviation of a designated reference/control group.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "StandardizedMeanDifferenceEffectSize",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "Glass's delta is particularly useful when the experimental intervention may alter variability, making a pooled SD inappropriate.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "GlasssDelta"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:StandardizedMeanDifferenceEffectSize"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:WeightingScheme",
    "urn:ms-quant:definition": [
      {
        "@value": "A computational strategy that assigns numerical weights to individual quantitative measurements to determine their relative contributions to an aggregated abundance estimate in a proteomics analysis.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "WeightingScheme"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:AggregationMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:ReferenceBasedNormalization",
    "urn:ms-quant:name": [
      {
        "@value": "Reference-based normalization",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A normalization method in which measurements are normalized relative to a designated reference, such as a pooled or common reference sample.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "NormalizationMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "The method reduces inter-batch variability using a shared reference. Its effectiveness depends on reference sample quality and consistency.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "ReferenceBasedNormalization",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:NormalizationMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:BenjaminiHochbergCorrection",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "BenjaminiHochbergCorrection"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:MultipleTestingCorrectionMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:CorrectionFactorEntry",
    "urn:ms-quant:definition": [
      {
        "@value": "An individual entry in a correction factor matrix that specifies the contribution of isotopic impurities from one isobaric labeling channel to another, used to correct reporter ion intensities in quantitative proteomics.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "CorrectionFactorEntry"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "_:structure001"
      },
      {
        "@id": "_:structure004"
      },
      {
        "@id": "_:structure005"
      },
      {
        "@id": "urn:ms-quant:ExperimentalDesign"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:ClassicLFQAggregation",
    "urn:ms-quant:definition": [
      {
        "@value": "Label-free quantification aggregation using the original Cox et al.\n2008 ratio-based approach, prior to the introduction of MaxLFQ.\nProtein intensities are derived from the median of all pairwise\npeptide intensity ratios across samples.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "ClassicLFQAggregation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@value": "PMID:18511468",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:UserAppliedAggregation"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:PLSReduction",
    "urn:ms-quant:definition": [
      {
        "@value": "A supervised dimensionality reduction method that uses partial least squares (PLS) to derive latent components that maximize covariance between predictor variables and response variables.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "PLSReduction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:SupervisedDimensionalityReduction"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:hasLabel",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "hasLabel"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:PeptideCount",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "PeptideCount"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@value": "MS:1001895",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:CountMeasure"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:LDAReduction",
    "urn:ms-quant:definition": [
      {
        "@value": "A supervised linear dimensionality reduction method that uses linear discriminant analysis (LDA) to identify projections maximizing between-class separation relative to within-class variation.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "LDAReduction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:SupervisedDimensionalityReduction"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:QuantifiedProteinGroup",
    "urn:ms-quant:definition": [
      {
        "@value": "A group of proteins that cannot be unambiguously distinguished based on the available peptide evidence and for which a collective quantitative abundance measurement is determined.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "QuantifiedProteinGroup"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:QuantifiedEntity"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:TruncatedSVD",
    "urn:ms-quant:definition": [
      {
        "@value": "A linear dimensionality reduction method that approximates a data matrix using a specified number of its largest singular values and corresponding singular vectors.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "TruncatedSVD"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:LinearDimensionalityReduction"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:MeanDifferenceEffectSize",
    "urn:ms-quant:generated_by": [
      {
        "@value": "StatisticalSoftware",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "EffectSize",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "An effect size expressing the difference between two group means in original measurement units.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "MeanDifferenceEffectSize",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:EffectSize"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:LocallyLinearEmbedding",
    "urn:ms-quant:definition": [
      {
        "@value": "A nonlinear dimensionality reduction method that preserves local neighborhood relationships by reconstructing each observation from its neighbors and embedding the data in a lower-dimensional space.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "LocallyLinearEmbedding"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:NonlinearDimensionalityReduction"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:MinProbImputation",
    "urn:ms-quant:name": [
      {
        "@value": "MinProb imputation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:has_exact_synonym": [
      {
        "@value": "MinimumProbabilityImputation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:definition": [
      {
        "@value": "A missing value imputation method in which each missing measurement is replaced by a random value drawn from a left-shifted probability distribution representing low-abundance signals near the limit of detection, with parameters chosen to assign minimal probability to higher intensities.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
        "@value": "LeftCensoredImputationMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      },
      {
        "@value": "MissingValueImputationMethod",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:comment": [
      {
        "@value": "minProb imputation models missing values as left-censored due to limited detectability. Results depend on distribution parameters (e.g., width and downshift) and introduce stochastic variability.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "MinProbImputation",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:LeftCensoredImputationMethod"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:IsobaricLabelQuantification",
    "urn:ms-quant:definition": [
      {
        "@value": "A label-based quantification method that uses isobaric chemical tags to label multiple samples, enabling relative quantification through reporter ions generated during tandem mass spectrometry.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#Class"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "IsobaricLabelQuantification"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@value": "MS:1002009",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      },
      {
        "@value": "MS:1002023",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "urn:ms-quant:LabelBasedQuantification"
      }
    ]
  },
  {
    "@id": "urn:ms-quant:generatedBy",
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
      {
        "@id": "http://www.w3.org/2002/07/owl#ObjectProperty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "urn:ms-quant:Result"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "generatedBy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "urn:ms-quant:Method"
      },
      {
        "@id": "urn:ms-quant:Software"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
