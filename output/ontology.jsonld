  {
    "@id": "urn:ms-quant:PPM",
    "urn:ms-quant:definition": [
      {
        "@value": "An abundance unit representing parts per million, corresponding to one part of an analyte per million parts of the reference quantity.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/1999/02/22-rdf-syntax-ns#type": [
