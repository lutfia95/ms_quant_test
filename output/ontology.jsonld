    "urn:ms-quant:definition": [
      {
        "@value": "The base-10 logarithm of the fold change between two experimental conditions.",
        "@type": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "urn:ms-quant:is_a": [
      {
